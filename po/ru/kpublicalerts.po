#: app/caputil.cpp:50
msgid "Extreme — Extraordinary threat to life or property"
msgstr "Чрезвычайная — исключительная угроза жизни или имуществу"

#: app/caputil.cpp:51
msgid "Severe — Significant threat to life or property"
msgstr "Серьёзная — значительная угроза жизни или имуществу"

#: app/caputil.cpp:52
msgid "Moderate — Possible threat to life or property"
msgstr "Умеренная — возможная угроза жизни или имуществу"

#: app/caputil.cpp:53
msgid "Minor — Minimal to no known threat to life or property"
msgstr ""
"Незначительная — минимальная угроза жизни или имуществу либо её отсутствие"

#: app/caputil.cpp:57
msgid "Responsive action should be taken immediately"
msgstr "Ответные меры необходимо принять немедленно"

#: app/caputil.cpp:58
msgid "Responsive action should be taken soon"
msgstr "Ответные меры необходимо принять в скором времени"

#: app/caputil.cpp:59
msgid "Responsive action be taken in the near future"
msgstr "Ответные меры необходимо принять в ближайшем будущем"

#: app/caputil.cpp:60
msgid "Responsive action is no longer required"
msgstr "Ответные меры больше не требуются"

#: app/caputil.cpp:64
msgid "Occurred or ongoing"
msgstr "Произошло или происходит"

#: app/caputil.cpp:65
msgid "Likely (> 50%)"
msgstr "Вероятно (> 50 %)"

#: app/caputil.cpp:66
msgid "Possible but not likely (< 50%)"
msgstr "Возможно, но маловероятно (< 50 %)"

#: app/caputil.cpp:67
msgid "Not expected to occur"
msgstr "Не ожидается"

#: app/caputil.cpp:71
msgid "Geophysical"
msgstr "Геофизические явления"

#: app/caputil.cpp:72
msgid "Meteorological"
msgstr "Метеорологические явления"

#: app/caputil.cpp:73
msgid "General emergency and public safety"
msgstr "Чрезвычайные ситуации и общественная безопасность"

#: app/caputil.cpp:74
msgid "Law enforcement, military, homeland and local/private security"
msgstr "Правопорядок, армия, государственная, местная и частная безопасность"

#: app/caputil.cpp:75
msgid "Rescue and recovery"
msgstr "Спасательные и восстановительные работы"

#: app/caputil.cpp:76
msgid "Fire"
msgstr "Пожары"

#: app/caputil.cpp:77
msgid "Medical and public health"
msgstr "Медицина и здравоохранение"

#: app/caputil.cpp:78
msgid "Pollution and other environmental event"
msgstr "Загрязнение и другие экологические события"

#: app/caputil.cpp:79
msgid "Transportation"
msgstr "Транспорт"

#: app/caputil.cpp:80
msgid "Utility, telecommunication, other non-transport infrastructure"
msgstr "Коммунальные службы, связь и другая нетранспортная инфраструктура"

#: app/caputil.cpp:81
msgid ""
"Chemical, biological, radiological, nuclear or high-yield explosive threat "
"or attack"
msgstr ""
"Химическая, биологическая, радиационная, ядерная угроза, угроза мощного "
"взрыва или нападение"

#: app/caputil.cpp:82
msgid "Other event"
msgstr "Прочие события"

#: app/caputil.cpp:86
msgid "Take shelter in place or per instructions."
msgstr "Укрыться на месте или согласно инструкциям."

#: app/caputil.cpp:87
msgid "Relocate as instructed."
msgstr "Эвакуироваться согласно инструкциям."

#: app/caputil.cpp:88
msgid "Make preparations as per the instructions."
msgstr "Подготовиться согласно инструкциям."

#: app/caputil.cpp:89
msgid "Execute activities identified in the instructions."
msgstr "Выполнить действия, указанные в инструкциях."

#: app/caputil.cpp:90
msgid "Avoid the subject event as per the instructions."
msgstr "Избегать места события согласно инструкциям."

#: app/caputil.cpp:91
msgid "Attend to information sources as described in the instructions."
msgstr "Следить за источниками информации, указанными в инструкциях."

#: app/caputil.cpp:92
msgid "Evaluate the information in this message."
msgstr "Оценить информацию в этом сообщении."

#: app/caputil.cpp:93
msgid ""
"The subject event no longer poses a threat or concern and any follow on "
"action is described in the instructions."
msgstr ""
"Событие больше не представляет угрозы; дальнейшие действия описаны в "
"инструкциях."

#: app/caputil.cpp:94
msgid "No action recommended."
msgstr "Действия не требуются."

